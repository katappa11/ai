import java.util.Scanner;

public class NumberGuessingAgent {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int low = 1;
        int high = 100;
        int guess;

        System.out.println("Think of a number between 1 and 100.");

        while (low <= high) {

            guess = (low + high) / 2;

            System.out.println("My guess is: " + guess);
            System.out.print("Enter feedback (higher/lower/correct): ");

            String feedback = sc.nextLine().toLowerCase();

            if (feedback.equals("higher")) {
                low = guess + 1;
            }
            else if (feedback.equals("lower")) {
                high = guess - 1;
            }
            else if (feedback.equals("correct")) {
                System.out.println("Number guessed successfully!");
                break;
            }
            else {
                System.out.println("Invalid feedback. Try again.");
            }
        }

        if (low > high) {
            System.out.println("Inconsistent feedback! No possible number remains.");
        }

        sc.close();
    }
}
